# Netlify / Cloudflare Pages response headers.
#
# These are the headers a <meta> tag cannot set. The browser ignores
# http-equiv="X-Frame-Options" completely, and ignores frame-ancestors,
# sandbox and report-uri inside a meta CSP — so clickjacking protection
# only actually applies when it arrives as a real header, from here.
#
# GitHub Pages serves no custom headers; the meta CSP in each page is the
# fallback there and covers everything except frame-ancestors.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; script-src 'self'; connect-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# A week, revalidated in the background. Not `immutable` and not a year: these
# filenames carry no content hash, so a replaced photograph has to be able to
# reach people who already have the old one cached.
/assets/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The kitchen dashboard. It needs the one thing the public site forbids
# outright — an outbound connection — so it gets its own rule rather than a
# hole punched in the site-wide one. Both this and the page's own meta CSP
# apply, and a browser enforces the intersection, so the two must agree:
# widening one alone changes nothing. Self-hosting Supabase? Change the
# supabase.co patterns in both places.
#
# Note the difference from the public site: no img-src for photographs, because
# there are none, and no font-src, because the dashboard uses system faces so a
# tablet never waits on a font server to show that an order has arrived.
/admin/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self'; style-src 'self'; script-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Cache-Control: no-cache

/kitchen/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self'; style-src 'self'; script-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  # Always revalidate. A tablet that has been on the counter for six months
  # must not be running a cached copy of a dashboard that has since been fixed.
  Cache-Control: no-cache
